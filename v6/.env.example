# FLOWER Reviews V6 — staging only. Do not commit real credentials.
# Required ONLY after an independent, durable database has been provisioned.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
PUBSUB_AUDIENCE=https://flower-reviews-v6-staging.onrender.com/pubsub/reviews
PUBSUB_SERVICE_ACCOUNT_EMAIL=
CRON_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Populate with four independently verified official GBP IDs:
BRANCH_NAMES_JSON={}
PUBSUB_LOCATION_ALIASES_JSON={}
AUTO_REPLY_ENABLED=false
OWNER_EXPRESS_CONSENT=false
# Owner policy: auto-reply to positive reviews (4 or 5 stars) with no negative/complaint wording.
# 1-3 stars always manual. Values below 4 are raised to 4; set 5 for five-star only.
AUTO_REPLY_MIN_STARS=4
AUTO_REPLY_MAX_AGE_HOURS=72
MAX_DRAIN_BATCH=5
BACKFILL_ENABLED=false
MAX_BACKFILL_REVIEWS=100
# 2026 five-star backfill. Canary: set the exact owner-approved review resource;
# AUTO_REPLY_ENABLED must stay false during the canary.
BACKFILL_CANARY_REVIEW=
# SHA-256 of the exact owner-approved canary reply text; the canary publishes that text verbatim.
BACKFILL_CANARY_REPLY_SHA256=
# Bulk 2026 backfill; effective only after one canary reply is confirmed by readback.
BACKFILL_PUBLISH_ENABLED=false
ALLOW_SQLITE_DEV=false
LOG_LEVEL=INFO
